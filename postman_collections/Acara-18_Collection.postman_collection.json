    "item": [
        {
            "name": "1. GET Mahasiswa - Format Response Envelope",
            "request": {
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "http://localhost/bkpm-web-server-afif/acara18/public/mahasiswa",
                    "protocol": "http",
                    "host": [
                        "localhost"
                    ],
                    "path": [
                        "bkpm-web-server-afif",
                        "acara18",
                        "public",
                        "mahasiswa"
                    ]
                }
            },
            "response": [],
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test('Envelope keys exist', function () {",
                            "    var res = pm.response.json();",
                            "    pm.expect(res).to.have.property('success');",
                            "    pm.expect(res).to.have.property('message');",
                            "    pm.expect(res).to.have.property('data');",
                            "    pm.expect(res).to.have.property('timestamp');",
                            "});"
                        ]
                    }
                }
            ]
        },
