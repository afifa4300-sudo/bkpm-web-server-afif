{
    "info": {
        "_postman_id": "ddd9e767-9ac4-429c-ae94-4ba26790f97f",
        "name": "Acara 20 - JWT Token Authentication",
        "description": "Pengujian JWT Token, Login, Proteksi Endpoint via Bearer Token",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "1. POST /login (Generate JWT Token)",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json",
                        "type": "text"
                    }
                ],
                "url": {
                    "raw": "{{base_url}}/login",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "login"
                    ]
                },
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"username\": \"admin\",\n    \"password\": \"admin123\"\n}",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
                }
            },
            "response": [],
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test('Login Success 200', function () {",
                            "    pm.response.to.have.status(200);",
                            "    var res = pm.response.json();",
                            "    pm.expect(res.data).to.have.property('token');",
                            "    pm.environment.set('token', res.data.token);",
                            "});"
                        ]
                    }
                }
            ]
        },
        {
            "name": "2. GET /mahasiswa (Public Endpoint Tanpa Token)",
            "request": {
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "{{base_url}}/mahasiswa",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "mahasiswa"
                    ]
                }
            },
            "response": [],
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test('Public endpoint 200 OK', function () { pm.response.to.have.status(200); });"
                        ]
                    }
                }
            ]
        },
        {
            "name": "3. POST /mahasiswa Tanpa Token (401 Unauthorized)",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json",
                        "type": "text"
                    }
                ],
                "url": {
                    "raw": "{{base_url}}/mahasiswa",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "mahasiswa"
                    ]
                },
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"nim\": \"E41250911\",\n    \"nama\": \"No Token\",\n    \"prodi\": \"TI\",\n    \"angkatan\": 2024\n}",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
                }
            },
            "response": [],
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test('Status is 401 Unauthorized', function () { pm.response.to.have.status(401); });"
                        ]
                    }
                }
            ]
        },
        {
            "name": "4. POST /mahasiswa Dengan Bearer Token Valid",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json",
                        "type": "text"
                    }
                ],
                "url": {
                    "raw": "{{base_url}}/mahasiswa",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "mahasiswa"
                    ]
                },
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"nim\": \"E41250911\",\n    \"nama\": \"With Valid Token\",\n    \"prodi\": \"TI\",\n    \"angkatan\": 2024\n}",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
                },
                "auth": {
                    "type": "bearer",
                    "bearer": [
                        {
                            "key": "token",
                            "value": "{{token}}",
                            "type": "string"
                        }
                    ]
                }
            },
            "response": [],
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test('Status is 201 Created', function () { pm.response.to.have.status(201); });"
                        ]
                    }
                }
            ]
        }
    ]
}